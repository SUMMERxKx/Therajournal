# Supabase Configuration
# Get these values from your Supabase project dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AI Provider Configuration (Optional)
# Choose one of: groq, huggingface, ollama
VITE_AI_PROVIDER=groq

# Groq API Key (if using Groq - free tier available)
VITE_GROQ_API_KEY=your_groq_api_key_here

# Hugging Face API Key (if using Hugging Face - free tier available)
VITE_HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Ollama Configuration (if using Ollama - completely free)
VITE_OLLAMA_BASE_URL=http://localhost:11434

# Note: All AI features use completely free providers (Groq, Hugging Face, Ollama)
# No API keys or payments required for basic AI functionality!
