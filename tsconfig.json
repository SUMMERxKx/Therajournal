{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/components/*": [
        "./src/components/*"
      ],
      "@/screens/*": [
        "./src/screens/*"
      ],
      "@/api/*": [
        "./src/api/*"
      ],
      "@/auth/*": [
        "./src/auth/*"
      ],
      "@/crypto/*": [
        "./src/crypto/*"
      ],
      "@/data/*": [
        "./src/data/*"
      ],
      "@/search/*": [
        "./src/search/*"
      ],
      "@/ai/*": [
        "./src/ai/*"
      ],
      "@/store/*": [
        "./src/store/*"
      ],
      "@/utils/*": [
        "./src/utils/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
